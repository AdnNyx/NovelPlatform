# ==============================================================================
# Web Baca Novel Publik — Frontend Environment Configuration Template
# Copy to .env.local and configure for your environment.
# Note: Zero direct Supabase access. All queries route through NEXT_PUBLIC_API_URL.
# ==============================================================================

# Python FastAPI Backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Identity Services Client ID (for Google OAuth id_token on /login)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Application Brand Metadata
NEXT_PUBLIC_APP_NAME="Web Baca Novel Publik"
