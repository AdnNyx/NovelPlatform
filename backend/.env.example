# ==============================================================================
# Web Baca Novel Publik — Backend Environment Configuration Template
# Copy to .env and fill with your actual credentials. DO NOT commit .env.
# ==============================================================================

# Database Connection (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@db.yourproject.supabase.co:5432/postgres

# Supabase Storage & Service Key (Backend has 100% RBAC responsibility)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT & Authentication Configuration
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
READER_JWT_EXPIRE_DAYS=7
STAFF_JWT_EXPIRE_HOURS=2
STAFF_REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth (Reader Authentication via id_token)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# SMTP Email Configuration (for Staff 6-digit OTP delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=Web Baca Novel Publik <noreply@novelpublik.com>

# Frontend Origin & Production Environment Flag
FRONTEND_URL=http://localhost:3000
IS_PRODUCTION=False
